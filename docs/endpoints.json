{
  "info": {
    "name": "Dikti Indicator API",
    "description": "API Documentation for Dikti Indicator Application\n\nAuth mechanism: Credentials login returns user object directly (no JWT token).\nFrontend stores user in localStorage as 'iku-user-session'.\nFor API requests that require auth (e.g., /api/chat), include header: x-user-email\n\nNote: x-user-email is validated against the database (appUser table, isActive check).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentikasi user dengan email dan password.\n\nResponse: user object (not token)\nFrontend stores this in localStorage: 'iku-user-session'\n\nNote: No JWT token returned. User object contains: id, name, email, isActive, createdAt, updatedAt"
          },
          "response": [
            {
              "name": "Login Berhasil",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"user\": {\n    \"id\": \"usr_001\",\n    \"name\": \"John Doe\",\n    \"email\": \"user@example.com\",\n    \"isActive\": true,\n    \"createdAt\": \"2026-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"2026-01-01T00:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "Validasi Gagal",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Email dan password wajib diisi.\"\n}"
            },
            {
              "name": "Unauthorized - Wrong Credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": \"Email atau sandi institusi salah.\"\n}"
            },
            {
              "name": "Akun Dinonaktifkan",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"error\": \"Akun Anda telah dinonaktifkan. Silakan hubungi admin.\"\n}"
            },
            {
              "name": "Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"error\": \"Gagal memverifikasi login user dari database.\"\n}"
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Pendaftaran user baru. Password minimal 6 karakter."
          },
          "response": [
            {
              "name": "Register Berhasil",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"ok\": true\n}"
            },
            {
              "name": "Validasi Gagal",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Semua kolom pendaftaran wajib diisi.\"\n}"
            },
            {
              "name": "Email Sudah Terdaftar",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"error\": \"Email institusi ini sudah terdaftar.\"\n}"
            },
            {
              "name": "Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"error\": \"Gagal menyimpan pendaftaran user ke database.\"\n}"
            }
          ]
        },
        {
          "name": "Google OAuth Start",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/google/start",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "google", "start"]
            },
            "description": "Redirect user ke Google OAuth login.\nThis is a GET request that returns 302 redirect to Google."
          },
          "response": [
            {
              "name": "Redirect ke Google",
              "status": "Found",
              "code": 302,
              "body": "",
              "header": [
                {
                  "key": "Location",
                  "value": "https://accounts.google.com/o/oauth2/v2/auth..."
                }
              ]
            },
            {
              "name": "Client ID Not Configured",
              "status": "Bad Request",
              "code": 400,
              "body": ""
            }
          ]
        },
        {
          "name": "Google OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/google/callback?code=AUTH_CODE&state=STATE",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "google", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "AUTH_CODE"
                },
                {
                  "key": "state",
                  "value": "STATE"
                }
              ]
            },
            "description": "Google OAuth callback handler.\nServer exchanges code for token, gets user info, creates/updates user, and sets cookie 'iku_oauth_session'.\nThen redirects to /login?google_auth=success\n\nFrontend (login page) reads cookie 'iku_oauth_session' and stores it in localStorage as 'iku-user-session'."
          },
          "response": [
            {
              "name": "Redirect ke Login",
              "status": "Found",
              "code": 302,
              "body": "",
              "header": [
                {
                  "key": "Location",
                  "value": "/login?google_auth=success"
                }
              ]
            },
            {
              "name": "OAuth Error",
              "status": "Found",
              "code": 302,
              "body": "",
              "header": [
                {
                  "key": "Location",
                  "value": "/login?google_auth=error&error=..."
                }
              ]
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/password/forgot",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "password", "forgot"]
            },
            "description": "Request password reset.\nReturns a reset token (only in development via 'debugResetToken' field).\nToken is valid for 30 minutes.\n\nNote: Token is NOT returned in production for security reasons."
          },
          "response": [
            {
              "name": "Request Berhasil",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"ok\": true,\n  \"message\": \"Jika email terdaftar, instruksi reset password sudah dikirim.\",\n  \"debugResetToken\": \"abc123xyz...\"\n}"
            },
            {
              "name": "Validasi Gagal",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Email institusi wajib diisi.\"\n}"
            },
            {
              "name": "Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"error\": \"Gagal memproses permintaan reset password.\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-here\",\n  \"password\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/password/reset",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "password", "reset"]
            },
            "description": "Reset password dengan token dari email.\nPassword minimal 6 karakter."
          },
          "response": [
            {
              "name": "Reset Berhasil",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"ok\": true\n}"
            },
            {
              "name": "Validasi Gagal",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Token, password, dan konfirmasi wajib diisi.\"\n}"
            },
            {
              "name": "Token Invalid/Expired",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Token reset tidak valid atau sudah kedaluwarsa.\"\n}"
            },
            {
              "name": "Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"error\": \"Gagal mereset password.\"\n}"
            }
          ]
        }
      ]
    },
